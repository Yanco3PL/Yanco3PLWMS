* { box-sizing: border-box; }
body {
  margin: 0;
  background: #EEF1F3;
  color: #1B232C;
  font-family: 'IBM Plex Sans', sans-serif;
}
.app { max-width: 1180px; margin: 0 auto; padding: 28px 20px; }
.header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 22px; gap: 12px; flex-wrap: wrap; }
.eyebrow { font-size: 11px; letter-spacing: 0.06em; color: #1F6F8B; font-weight: 600; margin-bottom: 6px; }
.h1 { font-size: 22px; font-weight: 700; margin: 0; line-height: 1.25; }
.sub { font-size: 13.5px; color: #5B6672; margin-top: 6px; max-width: 480px; }
.save-state { font-size: 12px; color: #8A93A0; font-family: 'IBM Plex Mono', monospace; }
.error-msg { font-size: 12px; color: #C24B3F; margin-top: 4px; max-width: 220px; }
.user-label { font-size: 12px; color: #5B6672; margin-bottom: 6px; display: block; }

.summary-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px; margin-bottom: 20px; }
.card { background: #fff; border-left: 3px solid #1F6F8B; border-radius: 3px; padding: 14px; box-shadow: 0 1px 2px rgba(27,35,44,0.05); }
.card-total { background: #1B232C; border-left: 3px solid #D98C2B; color: #fff; }
.card-total .card-meta { color: #C7D0D6; }
.card-label { font-size: 11.5px; color: #5B6672; font-weight: 500; margin-bottom: 6px; }
.card-total .card-label { color: #C7D0D6; }
.card-big { font-size: 24px; font-weight: 700; font-family: 'IBM Plex Mono', monospace; line-height: 1; }
.card-meta { font-size: 11.5px; color: #8A93A0; margin-top: 6px; }

.tabs { display: flex; gap: 4px; margin-bottom: -1px; position: relative; z-index: 1; }
.tab { font-family: 'IBM Plex Sans', sans-serif; font-size: 13.5px; font-weight: 500; padding: 9px 16px; border-radius: 3px 3px 0 0; cursor: pointer; border: none; background: transparent; color: #5B6672; }
.tab.active { background: #fff; color: #1B232C; box-shadow: 0 -1px 0 #1F6F8B inset; }

.table-wrap { background: #fff; border: 1px solid #DDE3E7; border-radius: 0 4px 4px 4px; overflow-x: auto; }
.tab-toolbar { display: flex; justify-content: flex-end; gap: 10px; padding: 12px 12px 0; }
table { width: 100%; border-collapse: collapse; min-width: 900px; margin-top: 10px; }
thead tr { border-bottom: 1px solid #DDE3E7; }
th { text-align: left; font-size: 11.5px; font-weight: 600; color: #5B6672; padding: 10px 12px; white-space: nowrap; }
tbody tr { border-bottom: 1px solid #EEF1F3; }
tbody tr:hover { background: #F5F8F9; }
td { padding: 8px 12px; vertical-align: middle; }
.footnote { font-size: 12px; color: #8A93A0; padding: 10px 14px 14px; line-height: 1.5; }

.input { font-family: 'IBM Plex Mono', monospace; font-size: 13px; border: 1px solid #DDE3E7; border-radius: 3px; padding: 5px 7px; width: 100%; background: #fff; color: #1B232C; }
.input.text { font-family: 'IBM Plex Sans', sans-serif; }
.input:focus { outline: 2px solid #1F6F8B; outline-offset: 1px; }
.select { font-family: 'IBM Plex Sans', sans-serif; font-size: 13px; border: 1px solid #DDE3E7; border-radius: 3px; padding: 5px 7px; background: #fff; color: #1B232C; }
.btn { font-family: 'IBM Plex Sans', sans-serif; font-size: 13px; font-weight: 500; border-radius: 3px; padding: 7px 14px; border: 1px solid transparent; cursor: pointer; }
.btn:hover { opacity: 0.85; }
.btn-ghost { background: #fff; border: 1px solid #DDE3E7; color: #1B232C; }
.btn-primary { background: #1F6F8B; color: #fff; }
.del-btn { background: none; border: none; color: #8A93A0; cursor: pointer; font-size: 16px; }
.del-btn:hover { color: #C24B3F; }
.warn-tiny { font-size: 10.5px; color: #C24B3F; margin-top: 3px; }
.ok-tiny { font-size: 10.5px; color: #3F8F5F; margin-top: 3px; }
